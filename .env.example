# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Optional reference LLMs (W2+)
OPENAI_API_KEY=
GEMINI_API_KEY=

# DeepSeek's OpenAI-compatible base URL (default; change if using a proxy)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic model defaults
ANTHROPIC_MODEL_OPUS=claude-opus-4-7
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6

# DeepSeek model
DEEPSEEK_MODEL=deepseek-chat
