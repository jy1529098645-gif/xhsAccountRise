# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# DeepSeek's OpenAI-compatible API URL
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic model defaults
ANTHROPIC_MODEL_OPUS=claude-opus-4-7
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6

# DeepSeek model
DEEPSEEK_MODEL=deepseek-chat

# OpenAI default. gpt-5 needs org verification on some accounts;
# the backend silently falls back to gpt-4o when that's the case.
OPENAI_MODEL=gpt-5
